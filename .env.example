# ---- Database (local Docker default) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helpdesk"

# ---- AI (100% free) ----
# Google AI Studio key (free, no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional fully-local mode via Ollama (no key needed):
# OLLAMA_BASE_URL="http://localhost:11434"

# ---- Auth: Auth.js (self-hosted, no external account) ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ---- Real-time: built-in SSE (no external service needed) ----

# ---- Background jobs: self-hosted Postgres queue (no external service) ----
# Run the worker locally:  pnpm worker
WORKER_INTERVAL_MS="3000"
# Optional shared secret protecting /api/jobs/run (and Vercel Cron). Unset = open in dev.
JOBS_RUN_SECRET=""

# ---- Guardrails ----
AI_MONTHLY_COST_CAP_USD="0"
